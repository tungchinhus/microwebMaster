rules_version = '2';

// Luật Firestore cho project Firebase của chính Web Master (web khách hàng ở /site, quản trị ở /quan-tri).
// Đưa lên bằng: firebase deploy --only firestore:rules --project <project-id-cua-web-master>
// Cấp quyền admin: tạo tài liệu admins/{uid} (uid lấy ở Firebase Console > Authentication) bằng Console.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Danh sách admin: mỗi người chỉ đọc được tài liệu của mình; chỉ sửa được trong Console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Web của khách hàng: ai có link cũng xem được một web; chỉ admin liệt kê, tạo, sửa, xoá.
    match /customerSites/{siteId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();

      // Đơn hàng, đặt lịch, liên hệ do khách gửi từ web: ai cũng gửi được, chỉ admin đọc.
      match /submissions/{submissionId} {
        allow create: if request.resource.data.keys().hasOnly(['kind', 'data', 'items', 'total', 'createdAt'])
          && request.resource.data.kind in ['order', 'booking', 'contact', 'newsletter']
          && request.resource.data.data is map
          && request.resource.data.data.size() <= 12
          && request.resource.data.createdAt is number;
        allow read, delete: if isAdmin();
        allow update: if false;
      }
    }
  }
}
